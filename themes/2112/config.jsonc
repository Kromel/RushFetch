{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/themes/2112/logo.ans",
        "padding": {
            "right": 4
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "packages",
        "shell",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "uptime"
    ]
}
